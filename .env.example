# Nottepe web'deki gibi mod bazlı env dosyaları kullanılıyor, hiçbiri repoya girmiyor
# (bkz. eas.json + EAS hosted environment variables, "eas env:list" ile görülebilir).
# Backend HER ZAMAN nottepe.com — hiçbir .env localhost'a işaret etmemeli.
#   .env.development  -> `expo start` ile lokal geliştirme
#   .env.production   -> build/export
#   .env.local        -> kişisel override, diger ikisini ezer
EXPO_PUBLIC_API_URL=https://nottepe.com/api
