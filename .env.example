# Nottepe web'deki gibi mod bazlı env dosyaları kullanılıyor, hiçbiri repoya girmiyor:
#   .env.development  -> `expo start` ile lokal geliştirme (varsayılan: http://localhost:5000/api)
#   .env.production   -> build/export (nottepe.com backend'i)
#   .env.local        -> kişisel override (ör. Android emulator icin http://10.0.2.2:5000/api,
#                        gercek cihazdan test icin lokal ag IP'n), diger ikisini ezer
EXPO_PUBLIC_API_URL=http://localhost:5000/api
